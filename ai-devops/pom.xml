<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ai-devops</artifactId>

    <description>
        ai-devops 业务模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- Spring AI Anthropic（版本由 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!-- Spring AI DeepSeek（原生 DeepSeek 模块，走 OpenAI 兼容协议，版本由 BOM 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!-- Spring AI MCP 客户端（连外部 MCP server 调其工具，第12篇）。
             注意：MCP 子模块版本与 Spring AI 主版本解耦——
             Spring AI 2.0.1 BOM 管理的 spring-ai-mcp 是 1.1.2（不是 2.0.1），实测确认。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- Flyway 数据库版本管理（版本由 Spring Boot BOM 管理，无需写 version）-->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 单元测试（版本由 Spring Boot BOM 管理）-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit 架构约束测试（constitution 原则 IV 分层单向依赖的机械强制）-->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                集成测试插件：执行 *IT 后缀的测试类。
                - 与 maven-surefire-plugin 区分阶段：surefire 在 test 阶段跑 *Test，failsafe 在 integration-test 阶段跑 *IT。
                - mvn test 不触发集成测试（守卫靠环境变量跳过），mvn verify 才执行。
                - 版本与 surefire(3.2.5) 对齐，Spring Boot 4.1 父 pom 未托管 failsafe，需显式声明。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <executions>
                    <execution>
                        <goals>
                            <!-- integration-test：执行 *IT；verify：校验结果失败则构建失败 -->
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
